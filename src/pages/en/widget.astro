---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/${lang}/schoolvakanties/" title="Belgian school holiday countdown" width="100%" height="620" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the Belgian school holiday countdown for free" description="Show the countdown to the next Belgian school break free on your school or club website: copy the code once and new school years then appear by themselves." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed BE Schoolvakanties</h1>
    <p class="mt-3 text-lg text-navy-700">For schools, parents’ associations, youth groups and local media: copy once, and new school years appear by themselves.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Countdown to the next break</h2>
    <p>Visitors choose their Community and see how long it is until the next break, the breaks that follow and the next public holiday.</p>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>For the Dutch or French version, replace /embed/en/ with /embed/nl/ or /embed/fr/. Terms: the source line under the counter stays visible, the counter is not altered and it is provided without warranty. What your visitors choose stays on their device. Questions via the <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/schoolvakanties/`} title="Belgian school holiday countdown" width="100%" height="620" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
